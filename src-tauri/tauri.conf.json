{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Subtitle Tool",
  "version": "0.1.0",
  "identifier": "com.local.livesubtitletool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Live Subtitle Tool",
        "width": 960,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "resources/model-manifest.json",
      "../workers/out",
      "../workers/fixtures"
    ]
  }
}
